---
import "./technology.css";

const brands = [
	{ name: "FBT", image: "fbt-new.webp" },
	{ name: "Midas", image: "midas.webp" },
	{ name: "RCF", image: "rcf-logo.webp" },
	{ name: "Yamaha", image: "yamaha-logo.webp" },
];
---

<section class="technology" aria-labelledby="technology-title">
	<div class="technology-inner">
		<header class="technology-header">
			<h2 id="technology-title">Tecnología que nos respalda</h2>
			<p>
				Trabajamos con equipos de marcas líderes en audio y producción
				profesional para garantizar calidad, potencia y confiabilidad en
				cada evento.
			</p>
		</header>

		<div class="technology-carousel" aria-label="Marcas de equipos">
			<div class="technology-track">
				<ul class="technology-list">
					{
						brands.map((brand) => (
							<li class="technology-item">
								<img
									src={`/images/technology/${brand.image}`}
									alt={brand.name}
									loading="lazy"
									decoding="async"
								/>
							</li>
						))
					}
				</ul>
				<ul class="technology-list" aria-hidden="true">
					{
						brands.map((brand) => (
							<li class="technology-item">
								<img
									src={`/images/technology/${brand.image}`}
									alt=""
									loading="lazy"
									decoding="async"
								/>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
