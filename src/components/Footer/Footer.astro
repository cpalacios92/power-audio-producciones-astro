---
import './footer.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<footer class="site-footer">
	<div class="footer-main">
		<div class="footer-content">
			<section class="footer-brand" aria-label="Sobre Power Audio Producciones">
				<a href="/" class="footer-logo-link" aria-label="Power Audio Producciones, inicio">
					<img
						src="/images/power-audio-producciones-logo-header.webp"
						alt="Power Audio Producciones"
						class="footer-logo"
					/>
				</a>
				<p>
					Producción técnica para eventos en toda Colombia. Sonido profesional,
					iluminación, pantallas, tarimas y soluciones audiovisuales para bodas,
					eventos corporativos, sociales y conciertos.
				</p>
			</section>

			<section class="footer-contact" aria-labelledby="footer-contact-title">
				<h2 id="footer-contact-title">Contacto</h2>
				<ul>
					<li>
						<i class="bi bi-telephone" aria-hidden="true"></i>
						<a href="tel:+573127274932">+57 312 727 4932</a>
					</li>
					<li>
						<i class="bi bi-envelope" aria-hidden="true"></i>
						<a href="mailto:power-audio-produciones@gmail.com"
							>power-audio-produciones@gmail.com</a
						>
					</li>
					<li>
						<i class="bi bi-geo-alt" aria-hidden="true"></i>
						<span>CALLE 52a # 62 - 195 Bello, Antioquia</span>
					</li>
				</ul>
			</section>

			<section class="footer-social" aria-labelledby="footer-social-title">
				<h2 id="footer-social-title">Síguenos</h2>
				<div class="footer-social-links">
					<a
						href="https://www.instagram.com/poweraudioproducciones/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram (abre en una pestaña nueva)"
					>
						<i class="bi bi-instagram" aria-hidden="true"></i>
						<span>Instagram</span>
					</a>
					<a
						href="https://www.facebook.com/PowerAudioProducciones/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Facebook (abre en una pestaña nueva)"
					>
						<i class="bi bi-facebook" aria-hidden="true"></i>
						<span>Facebook</span>
					</a>
					<a
						href="https://api.whatsapp.com/send?phone=573127274932&text=Hola%21+Estoy+interesad%40+en+realizar+una+cotizaci%C3%B3n.+&utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQMMjU2MjgxMDQwNTU4AAGn2o3H7wAGGQCmIb1CytWErkAUNIxRGC4FqykKzgatvhDIA74-HS-Uht_mNyI_aem_WcmvODdvKRcfiQ5Iu5gkaQ"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="WhatsApp (abre en una pestaña nueva)"
					>
						<i class="bi bi-whatsapp" aria-hidden="true"></i>
						<span>WhatsApp</span>
					</a>
				</div>
			</section>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="footer-bottom-content">
			<p>Power Audio Producciones S.A.S.</p>
			<p>Copyright © 2026. Todos los derechos reservados.</p>
		</div>
	</div>
</footer>
